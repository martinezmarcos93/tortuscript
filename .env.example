# TortuScript — configuración local. Copiar a `.env` (junto a iniciar_web.py o en la carpeta de datos) y completar.
# `.env` nunca se versiona. Lo que ya esté definido en el entorno del sistema tiene prioridad sobre este archivo.

# ── Correo de cuenta (verificación y recuperación de contraseña) ──
# Vacío: el registro y la recuperación quedan deshabilitados (respuesta 503). Es el valor seguro por defecto.
# consola: el enlace se muestra en la terminal del servidor. SOLO para una instalación local de una sola máquina.
# smtp: entrega real por el servidor SMTP del proveedor contratado.
TORTU_EMAIL_MODO=

# Solo para smtp
TORTU_SMTP_HOST=
TORTU_SMTP_PUERTO=587
# starttls (puerto 587) | ssl (puerto 465) | ninguna (solo sin usuario, p. ej. un relay local de pruebas)
TORTU_SMTP_SEGURIDAD=starttls
TORTU_SMTP_USUARIO=
TORTU_SMTP_CLAVE=
# Dirección que ven las familias, p. ej.: TortuScript <no-responder@tu-dominio>
TORTU_EMAIL_REMITENTE=

# URL pública con la que se arman los enlaces de los correos. En uso local se deduce sola (http://127.0.0.1:<puerto>).
TORTU_URL_BASE=

# ── Ejecución del código de los chicos ──
# Vacío: subproceso local con límites (uso en la compu de la familia).
# docker: cada ejecución corre en un contenedor efímero sin red (ADR-033). Requiere Docker y la imagen:
#   docker build -f despliegue/sandbox/Dockerfile -t tortuscript-sandbox:1 .
# Si está en `docker` y el contenedor no puede arrancar, la ejecución falla: nunca vuelve al subproceso local.
TORTU_SANDBOX=
# TORTU_SANDBOX_IMAGEN=tortuscript-sandbox:1
# Cuántos programas de los chicos pueden correr a la vez en esta máquina (con o sin sandbox). Por defecto, la
# cantidad de núcleos (entre 2 y 8). Los que no entran esperan unos segundos en una cola acotada.
# TORTU_EJECUCIONES_MAX=4

# ── Tortu-LLM: ayuda con inteligencia artificial (ADR-035) ──
# Vacío: el tutor no existe. claude: usa la API de Anthropic. Además cada familia tiene que activarlo desde
# «Configuración de cuenta»; sin esa aceptación no se envía nada.
# Requiere instalar aparte el paquete `anthropic` (no está en requirements.txt: pasarlo antes por dependency-auditor)
# y una credencial en ANTHROPIC_API_KEY. Cada ayuda es una llamada paga a la API.
TORTU_TUTOR=
# TORTU_TUTOR_MODELO=claude-opus-5-5
# ANTHROPIC_API_KEY=

# ── Suscripción por transferencia (ADR-047) ──
# Vacío: la página «Suscripción» existe pero no se puede contratar. Para ofrecerla hacen falta alias e importe.
# El alias va SOLO en el `.env` de la instalación (nunca en el repositorio). Cada pago se confirma a mano con
#   python herramientas/gestionar_pagos.py
# TORTU_PAGO_ALIAS=
# TORTU_PAGO_TITULAR=          # opcional: el nombre que ve quien transfiere, para que compruebe el destinatario
# TORTU_PAGO_IMPORTE=          # plan TortuScript Premium, en pesos, p. ej. 9500 o 9500,50
# TORTU_PAGO_IMPORTE_CROCO=    # plan del nivel avanzado (Croco-Script). Se puede ofrecer uno solo de los dos planes
# TORTU_PAGO_DIAS=30           # días de acceso que cubre cada pago
# TORTU_PAGO_MONEDA=ARS

# ── Paso a Croco-Script, el nivel avanzado (ADR-037) ──
# Vacío: no se ofrece el paso. Con las dos variables aparece el botón «Ir a Croco-Script» para las cuentas con acceso.
# TORTU_CROCO_URL es la dirección de entrada de Croco-Script (termina en /entrar). TORTU_CROCO_CLAVE es un secreto de
# 32+ caracteres compartido SOLO entre los dos servidores: en Croco-Script va en CROCO_CLAVES como <kid>:<clave>.
# Generar uno:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# TORTU_CROCO_URL=http://127.0.0.1:5067/entrar
# TORTU_CROCO_CLAVE=
# TORTU_CROCO_KID=k1

# ── Modo servidor (solo para atender a terceros con `wsgi.py`; ver despliegue/README.md) ──
# TORTU_HOSTS=tortuscript.example,www.tortuscript.example
# TORTU_PROXIES=1
# TORTU_TOKEN=            # opcional, 32+ caracteres; si falta se genera uno por arranque

# ── Datos ──
# Fuerza otra carpeta de datos (progreso, cuentas, logs). Útil para pruebas o una instalación portátil.
# TORTUSCRIPT_DATOS=
